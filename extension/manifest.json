{
  "manifest_version": 3,
  "name": "눈길",
  "version": "0.24.2",
  "description": "눈과 목소리로 웹을 쓰세요. 시선 추적은 내 기기 안에서만 처리돼요.",
  "permissions": ["offscreen", "storage", "scripting", "tabs", "tts", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "눈길" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/strings.js", "lib/gaze-model.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
