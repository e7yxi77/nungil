{
  "manifest_version": 3,
  "name": "눈길 Nungil",
  "version": "0.4.2",
  "description": "Browse the web with your eyes and voice. Gaze tracking stays on your device.",
  "permissions": ["offscreen", "storage", "scripting", "tabs", "tts", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "눈길 Nungil" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/strings.js", "lib/gaze-model.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
